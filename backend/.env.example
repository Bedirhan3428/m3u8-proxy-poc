# Backend Express Server Port
PORT=5000

# Turkey / Custom Proxy Configuration (Optional)
# Supports HTTP, HTTPS, and SOCKS5 proxies.
# Example HTTP proxy: http://user:pass@185.220.101.5:8080
# Example SOCKS5 proxy: socks5://185.220.101.5:1080
PROXY_URL=

# Allowed CORS origins (comma separated or * for all)
CORS_ORIGIN=*
